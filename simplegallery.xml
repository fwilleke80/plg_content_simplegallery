<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
	<name>PLG_CONTENT_SIMPLEGALLERY</name>
	<author>Frank Willeke</author>
	<creationDate>2026-09-21</creationDate>
	<copyright>(c) 2026 by Frank Willeke</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<authorUrl>www.frankwilleke.com</authorUrl>
	<authorEmail>joomla-plugins@frankwilleke.de</authorEmail>
	<version>1.3.0</version>
	<description>PLG_CONTENT_SIMPLEGALLERY_XML_DESCRIPTION</description>
	<namespace path="src">Punga\Plugin\Content\SimpleGallery</namespace>
	<targetplatform name="joomla" version="5\.0|6\.0" />

	<files>
		<folder plugin="simplegallery">services</folder>
		<folder>src</folder>
		<folder>language</folder>
		<folder>media</folder>
		<folder>tmpl</folder>
		<filename>index.html</filename>
		<filename>LICENSE</filename>
		<filename>README.md</filename>
	</files>

	<media destination="plg_content_simplegallery" folder="media">
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.plg_content_simplegallery.ini</language>
		<language tag="en-GB">en-GB/en-GB.plg_content_simplegallery.sys.ini</language>
		<language tag="de-DE">de-DE/de-DE.plg_content_simplegallery.ini</language>
		<language tag="de-DE">de-DE/de-DE.plg_content_simplegallery.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic" label="PLG_CONTENT_SIMPLEGALLERY_FIELDSET_GALLERY">
				<field
					name="columns"
					type="number"
					label="PLG_CONTENT_SIMPLEGALLERY_COLUMNS_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_COLUMNS_DESC"
					default="4"
					min="1"
					max="12"
				/>

				<field
					name="thumb_width"
					type="number"
					label="PLG_CONTENT_SIMPLEGALLERY_THUMB_WIDTH_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_THUMB_WIDTH_DESC"
					default="240"
					min="32"
					max="2000"
				/>

				<field
					name="thumb_height"
					type="number"
					label="PLG_CONTENT_SIMPLEGALLERY_THUMB_HEIGHT_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_THUMB_HEIGHT_DESC"
					default="180"
					min="32"
					max="2000"
				/>

				<field
					name="show_captions"
					type="radio"
					label="PLG_CONTENT_SIMPLEGALLERY_SHOW_CAPTIONS_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_SHOW_CAPTIONS_DESC"
					default="0"
					class="btn-group btn-group-yesno"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="layout"
					type="list"
					label="PLG_CONTENT_SIMPLEGALLERY_LAYOUT_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_LAYOUT_DESC"
					default="grid"
				>
					<option value="grid">PLG_CONTENT_SIMPLEGALLERY_LAYOUT_GRID</option>
					<option value="slider">PLG_CONTENT_SIMPLEGALLERY_LAYOUT_SLIDER</option>
				</field>

				<field
					name="sort"
					type="list"
					label="PLG_CONTENT_SIMPLEGALLERY_SORT_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_SORT_DESC"
					default="filename"
				>
					<option value="filename">PLG_CONTENT_SIMPLEGALLERY_SORT_FILENAME</option>
					<option value="date">PLG_CONTENT_SIMPLEGALLERY_SORT_DATE</option>
					<option value="random">PLG_CONTENT_SIMPLEGALLERY_SORT_RANDOM</option>
				</field>

				<field
					name="sort_order"
					type="list"
					label="PLG_CONTENT_SIMPLEGALLERY_SORT_ORDER_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_SORT_ORDER_DESC"
					default="ascending"
				>
					<option value="ascending">PLG_CONTENT_SIMPLEGALLERY_SORT_ORDER_ASCENDING</option>
					<option value="descending">PLG_CONTENT_SIMPLEGALLERY_SORT_ORDER_DESCENDING</option>
				</field>
			</fieldset>

			<fieldset name="media" label="PLG_CONTENT_SIMPLEGALLERY_FIELDSET_MEDIA">
				<field
					name="media_types"
					type="list"
					label="PLG_CONTENT_SIMPLEGALLERY_MEDIA_TYPES_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_MEDIA_TYPES_DESC"
					default="images"
				>
					<option value="images">PLG_CONTENT_SIMPLEGALLERY_MEDIA_IMAGES</option>
					<option value="videos">PLG_CONTENT_SIMPLEGALLERY_MEDIA_VIDEOS</option>
					<option value="both">PLG_CONTENT_SIMPLEGALLERY_MEDIA_BOTH</option>
				</field>
			</fieldset>

			<fieldset name="lightbox" label="PLG_CONTENT_SIMPLEGALLERY_FIELDSET_LIGHTBOX">
				<field
					name="lightbox_mode"
					type="list"
					label="PLG_CONTENT_SIMPLEGALLERY_LIGHTBOX_MODE_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_LIGHTBOX_MODE_DESC"
					default="builtin"
				>
					<option value="builtin">PLG_CONTENT_SIMPLEGALLERY_LIGHTBOX_BUILTIN</option>
					<option value="external">PLG_CONTENT_SIMPLEGALLERY_LIGHTBOX_EXTERNAL</option>
					<option value="none">PLG_CONTENT_SIMPLEGALLERY_LIGHTBOX_NONE</option>
				</field>

				<field
					name="show_lightbox_metadata"
					type="radio"
					label="PLG_CONTENT_SIMPLEGALLERY_SHOW_LIGHTBOX_METADATA_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_SHOW_LIGHTBOX_METADATA_DESC"
					default="1"
					class="btn-group btn-group-yesno"
					showon="lightbox_mode:builtin"
				>
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>

				<field
					name="metadata_fields"
					type="checkboxes"
					label="PLG_CONTENT_SIMPLEGALLERY_METADATA_FIELDS_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_METADATA_FIELDS_DESC"
					default="date,author,location,copyright,dimensions,filesize"
					showon="lightbox_mode:builtin[AND]show_lightbox_metadata:1"
				>
					<option value="date">PLG_CONTENT_SIMPLEGALLERY_METADATA_DATE</option>
					<option value="author">PLG_CONTENT_SIMPLEGALLERY_METADATA_AUTHOR</option>
					<option value="location">PLG_CONTENT_SIMPLEGALLERY_METADATA_LOCATION</option>
					<option value="copyright">PLG_CONTENT_SIMPLEGALLERY_METADATA_COPYRIGHT</option>
					<option value="dimensions">PLG_CONTENT_SIMPLEGALLERY_METADATA_DIMENSIONS</option>
					<option value="filesize">PLG_CONTENT_SIMPLEGALLERY_METADATA_FILESIZE</option>
					<option value="filename">PLG_CONTENT_SIMPLEGALLERY_METADATA_FILENAME</option>
				</field>
			</fieldset>

			<fieldset name="advanced" label="PLG_CONTENT_SIMPLEGALLERY_FIELDSET_ADVANCED">
				<field
					name="cache_folder"
					type="text"
					label="PLG_CONTENT_SIMPLEGALLERY_CACHE_FOLDER_LABEL"
					description="PLG_CONTENT_SIMPLEGALLERY_CACHE_FOLDER_DESC"
					default="images/.simplegallery-cache"
					size="40"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
